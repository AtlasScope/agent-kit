digraph nav {
  rankdir=LR; node [shape=box,fontsize=10];
  "chrome:src/components/MobileHeader.tsx" -> "/" [label="nav-item"];
  "chrome:src/components/MobileHeader.tsx" -> "/tickets" [label="nav-item"];
  "chrome:src/components/MobileHeader.tsx" -> "/customers" [label="nav-item"];
  "chrome:src/components/NewTicketDialog.tsx" -> "/tickets/:ticketId" [label="push"];
  "chrome:src/components/Sidebar.tsx" -> "/sign-in" [label="replace"];
  "chrome:src/components/Sidebar.tsx" -> "/inbox" [label="nav-item"];
  "chrome:src/components/Sidebar.tsx" -> "/tickets" [label="nav-item"];
  "chrome:src/components/Sidebar.tsx" -> "/customers" [label="nav-item"];
  "chrome:src/components/Sidebar.tsx" -> "/knowledge" [label="nav-item"];
  "chrome:src/components/Sidebar.tsx" -> "/reports" [label="nav-item"];
  "chrome:src/components/Sidebar.tsx" -> "/settings/profile" [label="nav-item"];
  "shared:src/components/TicketTable.tsx" -> "/tickets/:ticketId" [label="link"];
  "chrome:src/components/TopNav.tsx" -> "/" [label="nav-item"];
  "chrome:src/components/TopNav.tsx" -> "/tickets" [label="nav-item"];
  "chrome:src/components/TopNav.tsx" -> "/customers" [label="nav-item"];
  "chrome:src/components/TopNav.tsx" -> "/knowledge" [label="nav-item"];
  "chrome:src/components/TopNav.tsx" -> "/reports" [label="nav-item"];
  "chrome:src/layouts/TicketsLayout.tsx" -> "/tickets" [label="link"];
  "shared:src/pages/Customers.tsx" -> "/customers/:customerId" [label="link"];
  "shared:src/pages/Customers.tsx" -> "/customers" [label="nav-item"];
  "/" -> "/tickets/status/:status" [label="link"];
  "/" -> "/tickets/:ticketId" [label="link"];
  "/" -> "/inbox" [label="link"];
  "/" -> "DEAD /reports/weekly" [label="link",color=red];
  "/" -> "/knowledge/saved-replies" [label="link"];
  "shared:src/pages/Knowledge.tsx" -> "/knowledge/saved-replies" [label="link"];
  "shared:src/pages/Knowledge.tsx" -> "/knowledge/:slug" [label="link"];
  "shared:src/pages/Knowledge.tsx" -> "/knowledge" [label="nav-item"];
  "shared:src/pages/Reports.tsx" -> "/reports/billing" [label="link"];
  "shared:src/pages/Reports.tsx" -> "/reports" [label="nav-item"];
  "/sign-in" -> "/" [label="replace"];
  "/tickets/:ticketId" -> "/customers/:customerId" [label="link"];
  "/tickets/:ticketId" -> "/tickets" [label="link"];
  "/tickets/:ticketId" -> "/" [label="nav-item"];
  "/tickets/:ticketId" -> "/inbox" [label="nav-item"];
  "chrome:src/pages/settings/SettingsArea.tsx" -> "/settings/profile" [label="nav-item"];
  "chrome:src/pages/settings/SettingsArea.tsx" -> "/settings/team" [label="nav-item"];
  "chrome:src/pages/settings/SettingsArea.tsx" -> "/settings/notifications" [label="nav-item"];
  "chrome:src/pages/settings/SettingsArea.tsx" -> "/settings/macros" [label="nav-item"];
  "file:src/router.tsx" -> "/" [label="link"];
  "file:src/router.tsx" -> "/sign-in" [label="redirect"];
}