{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "agent-kit": { "source": { "source": "github", "repo": "AtlasScope/agent-kit" } }
  },
  "enabledPlugins": {
    "design-kit@agent-kit": true,
    "engineering-kit@agent-kit": true,
    "experience-architecture@agent-kit": true,
    "working-style@agent-kit": true,
    "motion-kit@agent-kit": true
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lanes.mjs hook-create",
            "timeout": 120,
            "statusMessage": "Creating this session's worktree from the latest main..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lanes.mjs hook-remove",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
