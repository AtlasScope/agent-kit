 "clusters": [
  {
   "job": "Tests pass but prove little",
   "primary": "T06",
   "alts": [
    {
     "id": "T02",
     "when": "You suspect particular tests pass no matter what."
    },
    {
     "id": "T01",
     "when": "Lots of unit tests, no start-to-finish check."
    },
    {
     "id": "M06",
     "when": "You want proof that a fix you just made works."
    }
   ]
  },
  {
   "job": "Code is hard to change",
   "primary": "EC04",
   "alts": [
    {
     "id": "A03",
     "when": "Plain prompt with nothing to install."
    },
    {
     "id": "M12",
     "when": "A one-line cleanup pass on each pull request."
    },
    {
     "id": "M04",
     "when": "A proposed fix adds a setting, table or service."
    },
    {
     "id": "EC28",
     "when": "Only the code changed on this branch."
    }
   ]
  },
  {
   "job": "Are the numbers right?",
   "primary": "DBR01",
   "alts": [
    {
     "id": "PG01",
     "when": "One figure disagrees with its source."
    },
    {
     "id": "PG02",
     "when": "Every check passes but totals still look wrong."
    },
    {
     "id": "D02",
     "when": "The metric is computed in app code, not only in the database."
    }
   ]
  },
  {
   "job": "Fix a bug",
   "primary": "EC02",
   "alts": [
    {
     "id": "M03",
     "when": "The same kind of bug keeps coming back."
    },
    {
     "id": "M08",
     "when": "A read-only investigation already found the problem."
    },
    {
     "id": "EC17",
     "when": "One bug is fixed and you want its siblings."
    }
   ]
  },
  {
   "job": "Review a change before merging",
   "primary": "EC26",
   "alts": [
    {
     "id": "EC27",
     "when": "Security only."
    },
    {
     "id": "EC15",
     "when": "Security review that weighs how many callers each change reaches."
    },
    {
     "id": "EC31",
     "when": "You want blunt, ranked criticism and small fixes."
    }
   ]
  },
  {
   "job": "Ship a database change",
   "primary": "PG17",
   "alts": [
    {
     "id": "G02",
     "when": "Checking how old and new code coexist during the deploy window."
    },
    {
     "id": "DBR05",
     "when": "You also need a tested way to recover."
    }
   ]
  },
  {
   "job": "Plan before building",
   "primary": "M07",
   "alts": [
    {
     "id": "EC05",
     "when": "Product direction is still open and you want to be asked."
    },
    {
     "id": "EC06",
     "when": "The same interview, with a glossary and decision records."
    },
    {
     "id": "M09",
     "when": "Several ways to build it, and the choice is costly to undo."
    },
    {
     "id": "M02",
     "when": "Pressure-test one plan before you start."
    },
    {
     "id": "UI003",
     "when": "Planning one page's layout and behaviour."
    }
   ]
  },
  {
   "job": "The same fact stored twice",
   "primary": "A04",
   "alts": [
    {
     "id": "PG11",
     "when": "Both copies live inside the database."
    }
   ]
  },
  {
   "job": "Safe to retry",
   "primary": "R01",
   "alts": [
    {
     "id": "PG08",
     "when": "Imports and corrections that get replayed."
    },
    {
     "id": "I04",
     "when": "Scheduled jobs that overlap or die midway."
    }
   ]
  },
  {
   "job": "The app is slow",
   "primary": "P01",
   "alts": [
    {
     "id": "P02",
     "when": "Steps wait for each other for no reason."
    },
    {
     "id": "P08",
     "when": "One synchronous step blocks everything else."
    },
    {
     "id": "P03",
     "when": "You already suspect specific queries."
    },
    {
     "id": "UI022",
     "when": "Slow loading or janky scrolling in the browser."
    }
   ]
  },
  {
   "job": "What breaks as it grows",
   "primary": "PG14",
   "alts": [
    {
     "id": "P05",
     "when": "The whole app, not only the database."
    }
   ]
  },
  {
   "job": "History that changes meaning",
   "primary": "PG04",
   "alts": [
    {
     "id": "D03",
     "when": "Classification changes in app code, not only in stored data."
    }
